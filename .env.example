# BACKEND
DEV=true
OPENAI_API_KEY="api-key"
SECRET_KEY="supersecretkey"
# Use this to seed the database with flashcards on startup
SEED_FLASHCARDS=true

PGHOST=db
PGPORT=5432
PGDATABASE=tutor_db
PGUSER=localUser
PGPASSWORD=password

# PostgreSQL configuration for docker-compose db service
POSTGRES_DB=$PGDATABASE
POSTGRES_USER=$PGUSER
POSTGRES_PASSWORD=$PGPASSWORD

# FRONTEND
VITE_API_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8000