{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run backend in debug mode",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend/src",
          "remoteRoot": "/app/src"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Run frontend in debug mode",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
